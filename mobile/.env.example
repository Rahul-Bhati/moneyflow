# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are bundled into the
# app build, so never put secrets here — only public-safe keys + URLs.

# Clerk — same publishable key as the web app uses.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Where the Next.js API lives. On a phone via Expo Go this MUST be your
# computer's LAN IP, not localhost (the phone can't see localhost).
# Look at the "Network:" line your `next dev` prints, e.g.:
#   Network:       http://192.168.0.12:3000
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.12:3000
