# ───────────────────────────────────────────────────────────────
# MoneyFlow — environment variables
# Copy to `.env.local` and fill in. Never commit secrets.
# Each block is gated to the milestone that introduces it.
# ───────────────────────────────────────────────────────────────

# Supabase
# - SUPABASE_URL: your project URL, e.g. https://YOURPROJECT.supabase.co
# - SUPABASE_ANON_KEY: the public/anon key (M2+: paired with a Clerk JWT, RLS scopes data per user)
# - SUPABASE_SERVICE_ROLE_KEY: server secret, bypasses RLS. Reserved for admin tasks
#   (cron, webhooks). Never used for user-facing reads/writes after M2.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# M1 — Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# M2 — Clerk ↔ Supabase native integration
# No JWT template variable needed when using Clerk's native Supabase integration
# (the default session token is accepted by Supabase once Clerk is registered as
# a third-party auth provider in the Supabase dashboard).

# M6 — Expo mobile app (lives in mobile/.env, listed here for visibility)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# EXPO_PUBLIC_API_BASE_URL=

# M7 — Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
